    "name": {
      "text": "Sonic Staff",
      "data": {
        "ru": {
          "original": "Sonic Staff",
          "translation": "\u0421\u0432\u0435\u0440\u0445\u0437\u0432\u0443\u043a\u043e\u0432\u043e\u0439 \u043f\u043e\u0441\u043e\u0445"
        },
        "es": {
