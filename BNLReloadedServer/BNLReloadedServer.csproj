<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="LeaderboardTrophies\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="ControlPanel\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CouchDB.NET" Version="4.0.0" />
      <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
      <!-- Upstream only publishes a .NET Framework asset. This exact library is retained to keep
           the existing TrueSkill calculations stable; runtime coverage is part of the server smoke test. -->
      <PackageReference Include="Moserware.Skills" Version="1.0.0.1" NoWarn="NU1701" />
      <PackageReference Include="NetCoreServer" Version="8.0.7" />
      <PackageReference Include="NetOctree" Version="2.1.0" />
      <PackageReference Include="NumberPartitioning" Version="1.3.0" />
      <PackageReference Include="ObservableCollections" Version="3.3.4" />
      <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    </ItemGroup>

</Project>
