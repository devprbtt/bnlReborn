<Project Sdk="Microsoft.NET.Sdk">
  <!-- Live end-to-end clan test. Needs a local server started with BNL_REBORN_AUTH_PUBLIC_KEY_PATH pointing at the
       public key written by "keys <dir>"; then "run <dir>". Uses the client's ClanProtocol.cs (BnlClientProtocol). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <BnlClientProtocol Condition="'$(BnlClientProtocol)' == ''">$(MSBuildThisFileDirectory)../../../../../unity-projects/migration-6000.5.7f1/Assets/BNLCompatibility/Clans/ClanProtocol.cs</BnlClientProtocol>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BnlClientProtocol)" Link="ClanProtocol.cs" />
    <ProjectReference Include="../../BNLReloadedServer/BNLReloadedServer.csproj" />
  </ItemGroup>
</Project>
